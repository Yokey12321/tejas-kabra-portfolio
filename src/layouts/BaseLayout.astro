---
import {
  ArrowUpRight,
  Menu,
  X,
  FileText,
  CodeXml,
  BriefcaseBusiness,
} from "@lucide/astro";
import { profile } from "../data/profile";
import SiteMotion from "../components/SiteMotion.astro";
import "../styles/global.css";
import "../styles/site.css";
import "../styles/motion.css";

interface Props {
  title: string;
  description: string;
  image?: string;
}
const { title, description, image } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const canonical = Astro.site
  ? new URL(Astro.url.pathname, Astro.site)
  : undefined;
const socialImage =
  image && Astro.site ? new URL(image, Astro.site).href : undefined;
const nav = [
  { label: "Work", href: "/#projects", active: path.startsWith("/projects") },
  { label: "About", href: "/about/", active: path === "/about" },
  { label: "Resume", href: "/resume/", active: path === "/resume" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#111312" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Tejas Kabra" />
    {canonical && <meta property="og:url" content={canonical.href} />}
    {socialImage && <meta property="og:image" content={socialImage} />}
    <meta
      name="twitter:card"
      content={socialImage ? "summary_large_image" : "summary"}
    />
    {canonical && <link rel="canonical" href={canonical.href} />}
    <link
      rel="icon"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='6' fill='%23111312'/%3E%3Ctext x='32' y='43' text-anchor='middle' font-family='Arial' font-weight='700' font-size='30' fill='%23ff7947'%3ETK%3C/text%3E%3C/svg%3E"
    />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <header class="site-header">
      <nav class="shell site-nav" aria-label="Main navigation">
        <a class="site-brand" href="/" aria-label="Tejas Kabra home">
          <span class="brand-mark">
            TK<span>.</span>
          </span>
          <span>Tejas Kabra</span>
        </a>
        <button
          class="icon-button menu-toggle"
          type="button"
          aria-label="Open menu"
          aria-expanded="false"
          aria-controls="nav-links"
          data-menu-toggle
        >
          <Menu size={22} class="menu-open-icon" />
          <X size={22} class="menu-close-icon" />
        </button>
        <div class="nav-links" id="nav-links">
          {nav.map((item) => (
            <a href={item.href} aria-current={item.active ? "page" : undefined}>
              {item.label}
            </a>
          ))}
          <a class="nav-contact" href="#contact">
            Get in touch <ArrowUpRight size={16} />
          </a>
        </div>
      </nav>
    </header>
    <main id="main">
      <slot />
    </main>
    <SiteMotion />
    <footer id="contact" class="site-footer">
      <div class="shell contact-grid">
        <div>
          <p class="section-label">
            <span class="status-dot"></span> Looking ahead / Summer 2027
          </p>
          <h2>
            Let’s build
            <br />
            something that works.
          </h2>
          <p class="contact-description">
            I’m looking for a summer 2027 internship in electrical engineering,
            embedded systems, or hardware. Have a team I should talk to?
          </p>
          <a class="contact-email" href={`mailto:${profile.email}`}>
            {profile.email}
            <ArrowUpRight size={24} />
          </a>
        </div>
        <div class="contact-links">
          <a href={profile.linkedin} target="_blank" rel="noreferrer">
            <BriefcaseBusiness size={18} />
            LinkedIn
            <ArrowUpRight size={16} />
          </a>
          <a href={profile.github} target="_blank" rel="noreferrer">
            <CodeXml size={18} />
            GitHub
            <ArrowUpRight size={16} />
          </a>
          <a href="/resume/">
            <FileText size={18} />
            Resume
            <ArrowUpRight size={16} />
          </a>
        </div>
      </div>
      <div class="shell footer-bottom">
        <span>Texas A&amp;M Electrical Engineering</span>
        <span>&copy; {new Date().getFullYear()} Tejas Kabra</span>
        <a href="#main">
          Back to top <ArrowUpRight size={14} />
        </a>
      </div>
    </footer>
    <script>
      const toggle =
        document.querySelector<HTMLButtonElement>("[data-menu-toggle]");
      const links = document.getElementById("nav-links");
      const closeMenu = () => toggle?.setAttribute("aria-expanded", "false");
      toggle?.addEventListener("click", () =>
        toggle.setAttribute(
          "aria-expanded",
          String(toggle.getAttribute("aria-expanded") !== "true"),
        ),
      );
      links?.addEventListener("click", (event) => {
        if ((event.target as Element).closest("a")) closeMenu();
      });
      document.addEventListener("keydown", (event) => {
        if (
          event.key === "Escape" &&
          toggle?.getAttribute("aria-expanded") === "true"
        ) {
          closeMenu();
          toggle.focus();
        }
      });
      document.addEventListener("click", (event) => {
        if (!(event.target as Element).closest(".site-nav")) closeMenu();
      });
      window
        .matchMedia("(min-width: 701px)")
        .addEventListener("change", closeMenu);
    </script>
  </body>
</html>
