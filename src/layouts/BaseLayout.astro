---
import "../styles/global.css";
import "../styles/space-background.css";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const currentPath = Astro.url.pathname;
const resumeHref = "/assets/tejas-kabra-engineering-portfolio-spacex.pdf";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0a080d" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><rect width=%22100%22 height=%22100%22 fill=%22%23171914%22/><path d=%22M22 28h56M50 28v50%22 stroke=%22%23e5663a%22 stroke-width=%2212%22/></svg>" />
    <title>{title}</title>
    <style is:global>
      .volley-transition {
        position: fixed;
        inset: 0;
        z-index: 9999;
        overflow: hidden;
        pointer-events: none;
        visibility: hidden;
        opacity: 0;
        background:
          radial-gradient(circle at 28% 20%, rgba(179, 109, 255, 0.16), transparent 22rem),
          radial-gradient(circle at 72% 62%, rgba(255, 107, 44, 0.12), transparent 24rem),
          rgba(5, 4, 7, 0);
        transition:
          opacity 120ms ease,
          visibility 0s linear 720ms;
      }

      .volley-transition.is-active {
        visibility: visible;
        opacity: 1;
        background:
          radial-gradient(circle at 28% 20%, rgba(179, 109, 255, 0.2), transparent 22rem),
          radial-gradient(circle at 72% 62%, rgba(255, 107, 44, 0.16), transparent 24rem),
          rgba(5, 4, 7, 0.66);
        transition:
          opacity 80ms ease,
          visibility 0s;
      }

      .volley-transition::before {
        position: absolute;
        inset: 12% 7%;
        content: "";
        opacity: 0;
        border: 1px solid rgba(243, 240, 230, 0.16);
        background:
          linear-gradient(90deg, transparent calc(50% - 1px), rgba(243, 240, 230, 0.18) calc(50% - 1px) calc(50% + 1px), transparent calc(50% + 1px)),
          linear-gradient(rgba(243, 240, 230, 0.12) 1px, transparent 1px),
          linear-gradient(90deg, rgba(243, 240, 230, 0.1) 1px, transparent 1px);
        background-size: auto, 100% 25%, 25% 100%;
        transform: perspective(720px) rotateX(64deg) translateY(6rem);
        transform-origin: bottom;
      }

      .volley-transition.is-active::before {
        animation: volley-court-in 640ms cubic-bezier(0.22, 1, 0.36, 1) both;
      }

      .volley-transition::after {
        position: absolute;
        width: 34vw;
        min-width: 18rem;
        inset-block: -18%;
        left: -42vw;
        content: "";
        opacity: 0;
        transform: skewX(-18deg);
        background:
          linear-gradient(90deg, transparent, rgba(255, 107, 44, 0.16), rgba(243, 240, 230, 0.08), transparent);
        filter: blur(0.4px);
      }

      .volley-transition.is-active::after {
        animation: volley-wipe 650ms cubic-bezier(0.2, 0.9, 0.18, 1) both;
      }

      .volley-transition-trail {
        position: absolute;
        width: 72vw;
        height: 2px;
        left: -16vw;
        top: 58vh;
        opacity: 0;
        transform: rotate(-17deg);
        transform-origin: left center;
        background: linear-gradient(90deg, transparent, rgba(243, 240, 230, 0.78), rgba(255, 211, 49, 0.58), transparent);
        box-shadow:
          0 0 1.4rem rgba(255, 211, 49, 0.22),
          0 0 2.5rem rgba(32, 87, 166, 0.18);
      }

      .volley-transition.is-active .volley-transition-trail {
        animation: volley-trail 650ms cubic-bezier(0.2, 0.9, 0.18, 1) both;
      }

      .volley-transition-ball {
        position: absolute;
        width: clamp(4.4rem, 8vw, 6.8rem);
        aspect-ratio: 1;
        border-radius: 999px;
        opacity: 0;
        background:
          radial-gradient(circle at 34% 24%, rgba(255, 255, 255, 0.64), transparent 0 12%, transparent 24%),
          radial-gradient(circle at 52% 56%, transparent 0 39%, rgba(8, 10, 18, 0.38) 40% 41%, transparent 43%),
          conic-gradient(from 28deg, #ffd331 0 18%, #2057a6 18% 30%, #ffd331 30% 48%, #2057a6 48% 60%, #ffd331 60% 78%, #2057a6 78% 90%, #ffd331 90% 100%);
        box-shadow:
          inset -0.45rem -0.6rem 0.9rem rgba(0, 0, 0, 0.28),
          inset 0.4rem 0.35rem 0.55rem rgba(255, 255, 255, 0.22),
          0 1rem 2.4rem rgba(0, 0, 0, 0.45),
          0 0 2rem rgba(255, 211, 49, 0.18);
        will-change: transform, opacity;
      }

      .volley-transition-ball::before,
      .volley-transition-ball::after {
        position: absolute;
        inset: 12%;
        content: "";
        border-radius: 50%;
        border: 2px solid rgba(5, 4, 7, 0.32);
        clip-path: polygon(0 0, 58% 0, 42% 100%, 0 100%);
      }

      .volley-transition-ball::after {
        transform: rotate(118deg);
        border-color: rgba(255, 255, 255, 0.18);
      }

      .volley-transition.is-active .volley-transition-ball {
        animation: volley-serve 650ms cubic-bezier(0.16, 0.84, 0.22, 1) both;
      }

      body.volley-transitioning {
        cursor: progress;
      }

      @keyframes volley-serve {
        0% {
          opacity: 0;
          transform: translate3d(-14vw, 62vh, 0) rotate(-80deg) scale(0.82);
        }
        10% {
          opacity: 1;
        }
        54% {
          opacity: 1;
          transform: translate3d(45vw, 19vh, 0) rotate(430deg) scale(1.04);
        }
        100% {
          opacity: 0.96;
          transform: translate3d(112vw, 50vh, 0) rotate(900deg) scale(0.92);
        }
      }

      @keyframes volley-trail {
        0% {
          opacity: 0;
          transform: translate3d(-8vw, 5rem, 0) rotate(-17deg) scaleX(0.1);
        }
        24% {
          opacity: 0.85;
        }
        100% {
          opacity: 0;
          transform: translate3d(72vw, -18rem, 0) rotate(-17deg) scaleX(1);
        }
      }

      @keyframes volley-wipe {
        0% {
          opacity: 0;
          transform: translateX(0) skewX(-18deg);
        }
        18% {
          opacity: 1;
        }
        100% {
          opacity: 0;
          transform: translateX(148vw) skewX(-18deg);
        }
      }

      @keyframes volley-court-in {
        0% {
          opacity: 0;
          transform: perspective(720px) rotateX(64deg) translateY(7rem) scale(0.96);
        }
        28%,
        78% {
          opacity: 0.42;
        }
        100% {
          opacity: 0;
          transform: perspective(720px) rotateX(64deg) translateY(4rem) scale(1.02);
        }
      }

      @media (prefers-reduced-motion: reduce) {
        .volley-transition,
        .volley-transition.is-active {
          display: none;
        }
      }
    </style>
  </head>
  <body>
    <div class="site-space-bg" aria-hidden="true"></div>
    <div class="volley-transition" aria-hidden="true">
      <div class="volley-transition-trail"></div>
      <div class="volley-transition-ball"></div>
    </div>
    <a class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:bg-paper focus:p-3" href="#main">
      Skip to content
    </a>
    <header class="relative z-40 border-b hairline bg-paper/95">
      <nav class="shell flex h-24 items-center justify-between">
        <a class="group flex items-center gap-3" href="/" aria-label="Tejas Kabra home">
          <span class="grid h-9 w-9 place-items-center border border-ink/20 bg-panel font-mono text-sm font-bold text-signal">TK</span>
          <span>
            <strong class="block text-base leading-none tracking-tight">Tejas Kabra</strong>
            <span class="technical-label mt-1 block text-ink/45">Electrical Engineer</span>
          </span>
        </a>
        <div class="flex items-center gap-4 sm:gap-6">
          <a class:list={["technical-label text-[0.74rem] font-bold tracking-[0.12em] transition-colors hover:text-signal", currentPath.startsWith("/projects") ? "text-signal" : ""]} href="/#projects">
            Work
          </a>
          <a class:list={["technical-label text-[0.74rem] font-bold tracking-[0.12em] transition-colors hover:text-signal", currentPath === "/about/" ? "text-signal" : ""]} href="/about">
            About
          </a>
          <a class="hidden technical-label text-[0.74rem] font-bold tracking-[0.12em] transition-colors hover:text-signal sm:block" href={resumeHref}>
            Resume
          </a>
          <a class="hidden border border-ink/20 px-5 py-2.5 technical-label text-[0.74rem] font-bold tracking-[0.12em] transition-colors hover:border-signal hover:bg-signal hover:text-panel sm:block" href="https://github.com/Yokey12321">
            Contact
          </a>
        </div>
      </nav>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="border-t border-ink/10 bg-panel text-ink">
      <div class="shell grid gap-10 py-12 md:grid-cols-2 md:items-end">
        <div>
          <span class="eyebrow text-signal">Contact</span>
          <p class="mt-5 max-w-xl text-3xl font-semibold leading-tight tracking-[-0.035em]">
            Available for Fall 2026 electrical engineering co-op opportunities.
          </p>
        </div>
        <div class="md:text-right">
          <a class="text-lg underline decoration-signal decoration-2 underline-offset-8" href="https://github.com/Yokey12321">
            github.com/Yokey12321
          </a>
          <p class="technical-label mt-6 text-ink/40">Texas A&amp;M University // College Station, TX</p>
        </div>
      </div>
      <div class="border-t border-ink/10">
        <div class="shell flex flex-col gap-3 py-5 technical-label text-ink/40 sm:flex-row sm:justify-between">
          <span>Electrical engineering portfolio.</span>
          <span>© {new Date().getFullYear()} Tejas Kabra</span>
        </div>
      </div>
    </footer>
    <script is:inline>
      (() => {
        if (window.__tejasVolleyTransition) return;
        window.__tejasVolleyTransition = true;

        const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
        const overlay = document.querySelector(".volley-transition");
        if (!overlay) return;

        const clearTransition = () => {
          overlay.classList.remove("is-active");
          document.body.classList.remove("volley-transitioning");
        };

        window.addEventListener("pageshow", clearTransition);

        document.addEventListener("click", (event) => {
          const target = event.target instanceof Element ? event.target : null;
          const link = target?.closest("a[data-volley-transition]");
          if (!link || event.defaultPrevented || prefersReducedMotion.matches) return;
          if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
          if (link.target || link.hasAttribute("download")) return;

          const destination = new URL(link.href, window.location.href);
          const current = new URL(window.location.href);
          const samePageHash = destination.origin === current.origin && destination.pathname === current.pathname && destination.hash;
          if (destination.origin !== current.origin || samePageHash) return;

          event.preventDefault();
          document.body.classList.add("volley-transitioning");
          overlay.classList.remove("is-active");
          void overlay.offsetWidth;
          overlay.classList.add("is-active");

          window.setTimeout(() => {
            window.location.href = destination.href;
          }, 610);
        });
      })();
    </script>
  </body>
</html>
