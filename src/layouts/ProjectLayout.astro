---
import type { CollectionEntry } from "astro:content";
import type { MarkdownHeading } from "astro";
import { ArrowLeft, ArrowRight, ArrowUpRight } from "@lucide/astro";
import MottoBanner from "../components/MottoBanner.astro";
import ImageViewer from "../components/ImageViewer.astro";
import BaseLayout from "./BaseLayout.astro";
import connectBanner from "../assets/banners/connect.webp";
import habitBanner from "../assets/banners/habit-second-nature.webp";
import memoriesBanner from "../assets/banners/memories.webp";
import oneBallBanner from "../assets/banners/one-ball-heart-soul.webp";
import simplicityBanner from "../assets/banners/simplicity-fortitude.webp";
interface Props {
  frontmatter: CollectionEntry<"projects">["data"];
  headings: MarkdownHeading[];
  nextProject?: CollectionEntry<"projects">;
}
const { frontmatter: data, headings, nextProject } = Astro.props;
const banners = {
  connect: connectBanner,
  "habit-second-nature": habitBanner,
  "simplicity-fortitude": simplicityBanner,
  "one-ball-heart-soul": oneBallBanner,
  memories: memoriesBanner,
};
const bannerNames = {
  connect: "Connect",
  "habit-second-nature": "Habit is second nature",
  "simplicity-fortitude": "Simplicity and fortitude",
  "one-ball-heart-soul": "One ball, heart and soul",
  memories: "We don't need memories",
};
---

<BaseLayout
  title={`${data.title} | Tejas Kabra`}
  description={data.summary}
  image={data.heroImage?.src}
  projectTheme={data}
>
  <article
    class="project-case"
    style={`--project-accent:${data.accent};--project-accent-secondary:${data.accentSecondary};--project-surface:${data.themeSurface}`}
  >
    <div class="reading-progress" aria-hidden="true"></div>
    <div class="project-banner-stage">
      <MottoBanner
        image={banners[data.banner]}
        alt={`Haikyuu: ${bannerNames[data.banner]}`}
        accent={data.accent}
      />
    </div>
    <header class="shell case-intro">
      <a class="case-back" href="/#projects">
        <ArrowLeft size={15} /> Selected work
      </a>
      <div class="case-title-meta">
        <p class="section-label">{data.disciplines.join(" / ")}</p>
        <span class="case-file">
          Project {String(data.order).padStart(2, "0")}
        </span>
      </div>
      <h1>{data.title}</h1>
      <p class="case-summary">{data.summary}</p>
      <dl class="case-meta">
        <div>
          <dt>My role</dt>
          <dd>{data.role}</dd>
        </div>
        <div>
          <dt>Timeline</dt>
          <dd>{data.timeframe}</dd>
        </div>
        <div>
          <dt>Status</dt>
          <dd>
            {data.caseStudyReady
              ? data.status === "in-progress"
                ? "Ongoing"
                : "Complete"
              : "Case study in progress"}
          </dd>
        </div>
        <div>
          <dt>Tools</dt>
          <dd>{data.technologies.join(", ")}</dd>
        </div>
      </dl>
    </header>
    <section class="case-overview">
      <div class="shell">
        {data.outcome && (
          <div class="case-outcome">
            <p class="section-label">The result</p>
            <p>{data.outcome}</p>
          </div>
        )}
        <dl class="case-stats">
          {data.metrics.map((metric) => (
            <div>
              <dt>{metric.label}</dt>
              <dd>{metric.value}</dd>
            </div>
          ))}
        </dl>
      </div>
    </section>
    <div class="shell case-body-grid">
      <aside class="case-contents">
        <nav aria-label="On this page">
          <p class="section-label">On this page</p>
          <ol>
            {headings
              .filter((h) => h.depth === 2)
              .map((h) => (
                <li>
                  <a href={`#${h.slug}`} data-section-link>
                    {h.text}
                  </a>
                </li>
              ))}
          </ol>
        </nav>
        <a class="text-link" href="/resume/">
          Resume <ArrowUpRight size={15} />
        </a>
      </aside>
      <div class="case-study">
        <slot />
      </div>
    </div>
    <div class="shell case-next">
      <a class="text-link" href="/#projects">
        <ArrowLeft size={16} /> All work
      </a>
      {nextProject && (
        <a href={`/projects/${nextProject.id}/`}>
          <div>
            <p class="section-label">Next project</p>
            <h2>{nextProject.data.shortTitle}</h2>
          </div>
          <ArrowRight size={26} />
        </a>
      )}
    </div>
  </article>
  <ImageViewer />
  <script>
    const sections =
      document.querySelectorAll<HTMLElement>(".case-study h2[id]");
    const links = document.querySelectorAll<HTMLAnchorElement>(
      "[data-section-link]",
    );
    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries
          .filter((entry) => entry.isIntersecting)
          .sort(
            (a, b) => a.boundingClientRect.top - b.boundingClientRect.top,
          )[0];
        if (!visible) return;
        links.forEach((link) => {
          if (link.hash === `#${visible.target.id}`)
            link.setAttribute("aria-current", "location");
          else link.removeAttribute("aria-current");
        });
      },
      { rootMargin: "-5% 0px -65% 0px" },
    );
    sections.forEach((section) => observer.observe(section));
  </script>
</BaseLayout>
