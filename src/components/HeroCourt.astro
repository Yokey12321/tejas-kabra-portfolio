    <span class="technical-label">Embedded // Hardware // Power</span>
    <strong>PCB design.<br />Firmware. Testing.</strong>
  </div>
  <svg viewBox="0 0 100 100" class="hero-court-svg" aria-hidden="true">
    <defs>
      <linearGradient id="court-surface" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0%" stop-color="#211238"></stop>
        <stop offset="100%" stop-color="#0d0913"></stop>
