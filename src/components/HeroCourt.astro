    </defs>
    <rect x="9" y="14" width="82" height="72" rx="1.5" fill="url(#court-surface)" stroke="#f3f0e6" stroke-opacity=".28"></rect>
    <path d="M50 14V86M9 38H91M9 62H91" stroke="#f3f0e6" stroke-opacity=".22" stroke-width=".55"></path>
