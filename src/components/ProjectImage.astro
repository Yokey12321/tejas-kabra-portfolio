---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { Maximize2 } from "@lucide/astro";
interface Props {
  image: ImageMetadata;
  alt: string;
  caption?: string;
  variant?: "wide" | "full";
}
const { image, alt, caption, variant = "wide" } = Astro.props;
---

<figure class:list={["project-image", variant]}>
  <a
    class="project-image-link"
    href={image.src}
    target="_blank"
    rel="noreferrer"
    data-expand-image
    data-image-alt={alt}
    data-image-caption={caption || alt}
    aria-label={`Expand image: ${alt}`}
  >
    <Image
      class="project-image-media"
      src={image}
      alt={alt}
      widths={[600, 1000, 1600]}
      sizes="(max-width: 700px) calc(100vw - 40px), (max-width: 1100px) 65vw, 760px"
      loading="lazy"
      decoding="async"
    />
    <span class="image-expand" aria-hidden="true">
      <Maximize2 size={18} />
    </span>
  </a>
  {caption && <figcaption class="project-image-caption">{caption}</figcaption>}
</figure>
