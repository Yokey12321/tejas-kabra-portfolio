---
interface Props {
  title: string;
  category: string;
  accent: string;
  accentSecondary?: string;
  surface?: string;
  index: number;
}

const { title, category, accent, accentSecondary = accent, surface = "#050407", index } = Astro.props;
---

<div
  class="project-panel"
  style={`--team-accent:${accent};--team-accent-secondary:${accentSecondary};--team-surface:${surface}`}
>
  <div class="project-panel-stripes" aria-hidden="true"></div>
  <div class="project-panel-top">
    <span class="technical-label">Featured project</span>
    <span class="project-panel-number">{String(index + 1).padStart(2, "0")}</span>
  </div>
  <div class="project-panel-image">
    <div class="project-panel-placeholder">
      <span class="project-panel-mark">TK</span>
      <span class="technical-label">Artwork / project image</span>
    </div>
    <div class="project-panel-court" aria-hidden="true">
      <span></span>
      <span></span>
      <span></span>
    </div>
  </div>
  <div class="project-panel-caption">
    <span class="technical-label">{category}</span>
    <strong>{title}</strong>
    <small>Open case study ↗</small>
  </div>
</div>
