---
import type { ImageMetadata } from "astro";

interface Props {
  image: ImageMetadata;
  alt: string;
  accent?: string;
  compact?: boolean;
}

const { image, alt, accent = "#ff6b2c", compact = false } = Astro.props;
---

<figure
  class:list={["motto-banner", compact && "motto-banner-compact"]}
  style={`--banner-accent:${accent}`}
>
  <span class="motto-banner-index technical-label" aria-hidden="true">Team motto</span>
  <img
    src={image.src}
    alt={alt}
    loading="eager"
    decoding="async"
    fetchpriority="high"
    width={image.width}
    height={image.height}
  />
  <span class="motto-banner-line" aria-hidden="true"></span>
</figure>
