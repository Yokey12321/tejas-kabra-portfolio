---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";

const projects = (await getCollection("projects"))
  .filter(({ data }) => data.featured)
  .sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title="Tejas Kabra — Electrical Engineering"
  description="Electrical engineering portfolio focused on embedded systems, PCB design, CAN, telemetry, power electronics, and robotics."
>
  <section class="mx-auto grid min-h-[70vh] max-w-7xl content-center gap-10 px-6 py-20 lg:grid-cols-[1.4fr_0.6fr] lg:px-10">
    <div>
      <p class="font-mono text-xs uppercase tracking-[0.18em] text-signal">
        Electrical Engineering · Texas A&M
      </p>
      <h1 class="mt-6 max-w-5xl text-6xl font-semibold leading-[0.98] tracking-[-0.05em] lg:text-8xl">
        I build embedded systems that survive contact with the real world.
      </h1>
    </div>
    <p class="self-end text-lg leading-8 text-ink/65">
      Hardware and firmware spanning vehicle telemetry, custom STM32 boards, power protection,
      and robotic inventory systems.
    </p>
  </section>

  <section id="projects" class="mx-auto max-w-7xl px-6 pb-24 lg:px-10">
    <div class="mb-8 flex items-end justify-between border-b border-ink/20 pb-4">
      <h2 class="text-2xl font-semibold tracking-tight">Selected engineering work</h2>
      <span class="font-mono text-xs">{projects.length.toString().padStart(2, "0")} projects</span>
    </div>
    <ol>
      {
        projects.map(({ id, data }, index) => (
          <li class="border-b border-ink/15">
            <a class="group grid gap-5 py-8 sm:grid-cols-[4rem_1fr_auto] sm:items-baseline" href={`/projects/${id}/`}>
              <span class="font-mono text-xs text-ink/45">{String(index + 1).padStart(2, "0")}</span>
              <div>
                <h3 class="text-3xl font-semibold tracking-[-0.025em] transition-transform group-hover:translate-x-2">
                  {data.title}
                </h3>
                <p class="mt-3 max-w-3xl leading-7 text-ink/65">{data.summary}</p>
              </div>
              <span class="font-mono text-xs uppercase tracking-wider text-signal">{data.disciplines[0]}</span>
            </a>
          </li>
        ))
      }
    </ol>
  </section>
</BaseLayout>
