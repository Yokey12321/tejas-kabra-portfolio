---
import { getCollection } from "astro:content";
import NetDivider from "../components/NetDivider.astro";
import HeroCourt from "../components/HeroCourt";
import ProjectVisual from "../components/ProjectVisual.astro";
import ScrollServe from "../components/ScrollServe";
import BaseLayout from "../layouts/BaseLayout.astro";

const projects = (await getCollection("projects"))
  .filter(({ data }) => data.featured)
  .sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title="Tejas Kabra — Electrical Engineering"
  description="Electrical engineering portfolio focused on embedded systems, PCB design, CAN, telemetry, power electronics, and robotics."
>
  <section class="court-section court-lines relative overflow-hidden border-b hairline">
    <div class="shell grid min-h-[calc(100vh-5rem)] items-stretch lg:grid-cols-[1.08fr_0.92fr]">
      <div class="relative z-10 flex flex-col justify-center py-20 lg:py-28 lg:pr-16">
        <p class="eyebrow text-signal">Electrical Engineering // Texas A&amp;M</p>
        <h1 class="mt-7 max-w-4xl text-[clamp(4rem,8vw,8.5rem)] font-semibold leading-[0.82] tracking-[-0.075em]">
          Hardware,
          <span class="block text-ink/35">proven.</span>
        </h1>
        <p class="mt-10 max-w-2xl text-lg leading-8 text-ink/65 md:text-xl">
          I design embedded systems from schematic to field test—custom PCBs, vehicle telemetry,
          power electronics, and electromechanical systems built to produce measurable results.
        </p>
        <div class="mt-10 flex flex-wrap gap-4">
          <a class="bg-ink px-6 py-4 technical-label text-paper transition-transform hover:-translate-y-1" href="#projects">
            Explore the work <span class="ml-3 text-signal">↓</span>
          </a>
          <a class="border border-ink/20 px-6 py-4 technical-label transition-colors hover:border-ink" href="/about">
            About Tejas
          </a>
        </div>
      </div>
      <div class="relative min-h-[30rem] border-t hairline bg-panel text-ink lg:min-h-0 lg:border-l lg:border-t-0">
        <HeroCourt client:load />
      </div>
    </div>
  </section>

  <NetDivider label="First rotation" />

  <section class="border-b hairline bg-paper-deep">
    <div class="shell grid grid-cols-2 md:grid-cols-4">
      {["STM32 / ARM", "CAN / LTE", "PCB Design", "Power Electronics"].map((skill, index) => (
        <div class:list={["flex min-h-24 items-center gap-4 px-4 md:px-6", index > 0 && "border-l hairline"]}>
          <span class="font-mono text-xs text-signal">0{index + 1}</span>
          <span class="text-sm font-semibold">{skill}</span>
        </div>
      ))}
    </div>
  </section>

  <ScrollServe client:load />

  <section id="projects" class="court-section shell py-24 md:py-32">
    <div class="grid gap-8 border-b hairline pb-8 md:grid-cols-[1fr_auto] md:items-end">
      <div>
        <p class="eyebrow text-signal">Selected case studies</p>
        <h2 class="mt-5 text-5xl font-semibold leading-none tracking-[-0.055em] md:text-7xl">Engineering in context.</h2>
      </div>
      <p class="max-w-sm text-sm leading-6 text-ink/55 md:text-right">
        Each project documents the constraint, architecture, tradeoffs, validation, and what changed after testing.
      </p>
    </div>

    <div class="mt-12 grid gap-x-5 gap-y-16 md:grid-cols-2">
      {
        projects.map(({ id, data }, index) => (
          <article class:list={["project-card group", index % 2 === 1 && "md:mt-24"]} style={`--section-accent:${data.accent}`}>
            <a href={`/projects/${id}/`}>
              <div class="relative overflow-hidden transition-transform duration-500 group-hover:-translate-y-2">
                <ProjectVisual type={data.visual} accent={data.accent} compact />
                <span class="absolute left-5 bottom-5 border border-ink/15 bg-paper px-3 py-2 technical-label text-ink">
                  Case study 0{index + 1}
                </span>
              </div>
              <div class="grid gap-4 border-b hairline py-6 sm:grid-cols-[1fr_auto]">
                <div>
                  <p class="technical-label text-signal">{data.disciplines.join(" / ")}</p>
                  <h3 class="mt-3 text-3xl font-semibold leading-tight tracking-[-0.035em] md:text-4xl">{data.shortTitle}</h3>
                </div>
                <span class="mt-1 grid h-10 w-10 place-items-center rounded-full border border-ink/20 text-xl transition-colors group-hover:border-signal group-hover:bg-signal group-hover:text-paper">
                  ↗
                </span>
              </div>
              <p class="mt-4 max-w-xl leading-7 text-ink/60">{data.summary}</p>
              <div class="mt-6 grid grid-cols-3 gap-px bg-ink/15">
                {data.metrics.map((metric) => (
                  <div class="scoreboard p-3">
                    <strong class="score-digit block text-sm">{metric.value}</strong>
                    <span class="technical-label mt-1 block text-ink/40">{metric.label}</span>
                  </div>
                ))}
              </div>
            </a>
          </article>
        ))
      }
    </div>
  </section>

  <NetDivider label="Second rotation" />

  <section class="court-section court-lines bg-panel py-24 text-ink md:py-32">
    <div class="shell">
      <div class="grid gap-12 lg:grid-cols-[0.7fr_1.3fr]">
        <div>
          <p class="eyebrow text-signal">How I work</p>
          <h2 class="mt-6 text-4xl font-semibold leading-tight tracking-[-0.045em] md:text-6xl">
            The bench is where assumptions go to get tested.
          </h2>
        </div>
        <ol class="grid border-l border-t border-ink/15 md:grid-cols-2">
          {[
            ["01 / Receive", "Define", "Read the environment: electrical, timing, thermal, mechanical, and interface constraints."],
            ["02 / Set", "Architect", "Put each function in position across hardware, firmware, communications, and power."],
            ["03 / Attack", "Instrument", "Commit to a design with test points, logs, and observability built in."],
            ["04 / Cover", "Iterate", "Stay with the play: use failure evidence and measurements to improve the next revision."],
          ].map(([number, title, body]) => (
            <li class="min-h-56 border-b border-r border-ink/15 p-7">
              <span class="technical-label text-signal">{number}</span>
              <h3 class="mt-10 text-2xl font-semibold">{title}</h3>
              <p class="mt-4 text-sm leading-7 text-ink/55">{body}</p>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <NetDivider label="Match point" />

  <section class="court-section shell py-20 md:py-28">
    <div class="grid gap-10 lg:grid-cols-[1.2fr_0.8fr] lg:items-end">
      <blockquote class="text-4xl font-semibold leading-[1.08] tracking-[-0.045em] md:text-6xl">
        “Good engineering is a chain of decisions you can explain.”
      </blockquote>
      <div>
        <p class="leading-7 text-ink/60">
          This portfolio is built around that chain: what the system needed to do, why the architecture took its shape,
          what broke, and what the instruments said next.
        </p>
        <a class="mt-8 inline-block border-b-2 border-signal pb-2 technical-label" href="/about">More about my approach →</a>
      </div>
    </div>
  </section>
</BaseLayout>
