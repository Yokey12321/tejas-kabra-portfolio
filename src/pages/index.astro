---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import { ArrowDown, ArrowUpRight, ArrowRight, FileText } from "@lucide/astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import ScrollServe from "../components/ScrollServe.astro";
import flyBanner from "../assets/banners/fly.webp";
import { profile } from "../data/profile";

const allProjects = (await getCollection("projects"))
  .filter((p) => p.data.featured)
  .sort((a, b) => a.data.order - b.data.order);
const projects = allProjects.filter((p) => p.data.caseStudyReady);
const inProgress = allProjects.filter((p) => !p.data.caseStudyReady);
const filters = [
  { value: "all", label: "All work" },
  { value: "electronics", label: "Electronics" },
  { value: "robotics", label: "Robotics" },
];
---

<BaseLayout
  title="Tejas Kabra | Electrical Engineering"
  description="SpaceX Engineering Intern and Texas A&M electrical engineering student. Custom PCBs, embedded systems, and robotics. Seeking summer 2027 internships."
  image={projects[0]?.data.heroImage?.src}
>
  <section class="home-hero">
    <img
      class="hero-motto"
      src={flyBanner.src}
      width={flyBanner.width}
      height={flyBanner.height}
      alt="Haikyuu: Fly"
      fetchpriority="high"
    />
    <div class="shell hero-content">
      <p class="section-label">Electrical engineering / Texas A&amp;M</p>
      <h1>Tejas Kabra</h1>
      <p class="hero-description">
        I design boards, write firmware,
        <br class="desktop-break" /> and work out why the hardware isn’t
        behaving.
      </p>
      <div class="hero-actions">
        <a class="button button-primary" href="#projects">
          Explore my work <ArrowDown size={17} />
        </a>
        <a class="button button-quiet" href="/resume/">
          <FileText size={17} /> Resume
        </a>
      </div>
      <div class="hero-caption">
        <span class="status-dot"></span> Currently {profile.role} at{" "}
        <strong>{profile.employer}</strong>
      </div>
    </div>
    <div class="hero-edge" aria-hidden="true">
      <span>01 / Keep moving forward</span>
      <span>飛べ</span>
    </div>
  </section>
  <div class="availability-band">
    <div class="shell">
      <span>
        Currently at <strong>SpaceX</strong>
      </span>
      <a href="#contact">
        Open to <strong>summer 2027 internships</strong>{" "}
        <ArrowUpRight size={16} />
      </a>
      <span class="band-detail">Hardware. Firmware. The work between.</span>
    </div>
  </div>
  <section id="projects" class="work-section shell">
    <div class="section-heading">
      <div>
        <p class="section-label">01 / Selected work</p>
        <h2>The projects.</h2>
      </div>
      <p>Custom PCBs, embedded systems, and robotics.</p>
    </div>
    <div class="project-toolbar">
      <div class="project-filters" role="group" aria-label="Filter projects">
        {filters.map((filter) => (
          <button
            type="button"
            data-project-filter={filter.value}
            aria-pressed={filter.value === "all"}
          >
            {filter.label}
            <span>
              {String(
                projects.filter(
                  (p) =>
                    filter.value === "all" || p.data.category === filter.value,
                ).length,
              ).padStart(2, "0")}
            </span>
          </button>
        ))}
      </div>
      <span
        class="project-count"
        aria-live="polite"
        aria-atomic="true"
        data-project-count
      >
        {projects.length} projects
      </span>
    </div>
    <div class="work-grid" data-project-grid>
      {projects.map(({ id, data }, index) => (
        <article
          class="work-card"
          data-project-card
          data-project-category={data.category}
          style={`--card-accent:${data.accent}`}
        >
          <a href={`/projects/${id}/`} class="work-card-link">
            <div class="work-image">
              {data.heroImage && (
                <Image
                  src={data.heroImage}
                  alt={data.heroImageAlt || data.title}
                  widths={[480, 800, 1200]}
                  sizes="(max-width: 700px) calc(100vw - 40px), (max-width: 1400px) 46vw, 600px"
                  loading={index < 2 ? "eager" : "lazy"}
                />
              )}
              <span class="work-index">0{index + 1}</span>
              <span class="work-arrow">
                <ArrowUpRight size={23} />
              </span>
            </div>
            <div class="work-card-heading">
              <p class="section-label">
                {data.disciplines.slice(0, 2).join(" / ")}
              </p>
              <span class="work-status">
                {data.status === "in-progress" ? "Ongoing" : "Case study"}
              </span>
            </div>
            <h3>{data.shortTitle}</h3>
            <p class="work-summary">{data.summary}</p>
            <dl class="work-metrics">
              {data.metrics.map((metric) => (
                <div>
                  <dt>{metric.label}</dt>
                  <dd>{metric.value}</dd>
                </div>
              ))}
            </dl>
          </a>
        </article>
      ))}
    </div>
    {inProgress.map(({ data }) => (
      <div class="work-in-progress">
        <div>
          <p class="section-label">Also on the bench / RoboMasters</p>
          <h3>{data.shortTitle}</h3>
          <p>{data.summary}</p>
        </div>
        <span class="in-progress-label">Case study in progress</span>
      </div>
    ))}
  </section>
  <section class="experience-section">
    <div class="shell experience-grid">
      <div>
        <p class="section-label">02 / Where I’m learning</p>
        <h2>
          Good hardware
          <br />
          takes a team.
        </h2>
        <a class="text-link" href="/about/">
          A little more about me <ArrowUpRight size={17} />
        </a>
      </div>
      <div class="experience-list">
        <div class="experience-row">
          <span class="experience-time">
            <span class="status-dot"></span> Currently
          </span>
          <div>
            <h3>SpaceX</h3>
            <p>Engineering Intern</p>
          </div>
          <ArrowUpRight size={21} aria-hidden="true" />
        </div>
        <div class="experience-row">
          <span class="experience-time">Student team</span>
          <div>
            <h3>Texas A&amp;M Formula Electric</h3>
            <p>Telemetry hardware, embedded firmware, and inventory systems</p>
          </div>
        </div>
        <div class="experience-row">
          <span class="experience-time">Student team</span>
          <div>
            <h3>Texas A&amp;M RoboMasters</h3>
            <p>Custom STM32 hardware and robot integration</p>
          </div>
        </div>
        <div class="experience-row">
          <span class="experience-time">Previously</span>
          <div>
            <h3>Southland Industries</h3>
            <p>
              Electrical design for modular data center cooling infrastructure
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>
  <div class="personal-band shell">
    <div>
      <p class="section-label">A little off the court</p>
      <p>
        Space, robotics, <em>Project Hail Mary</em>, and a soft spot for
        Haikyuu.
      </p>
    </div>
    <a class="text-link" href="/about/">
      Meet Tejas <ArrowRight size={18} />
    </a>
  </div>
  <ScrollServe />
  <script>
    const buttons = document.querySelectorAll<HTMLButtonElement>(
      "[data-project-filter]",
    );
    const cards = document.querySelectorAll<HTMLElement>("[data-project-card]");
    const count = document.querySelector("[data-project-count]");
    buttons.forEach((button) =>
      button.addEventListener("click", () => {
        const category = button.dataset.projectFilter;
        buttons.forEach((item) =>
          item.setAttribute("aria-pressed", String(item === button)),
        );
        let visible = 0;
        cards.forEach((card) => {
          card.hidden =
            category !== "all" && card.dataset.projectCategory !== category;
          if (!card.hidden) visible++;
        });
        if (count) count.textContent = `${visible} projects`;
      }),
    );
  </script>
</BaseLayout>
