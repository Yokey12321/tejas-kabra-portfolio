---
import { getCollection } from "astro:content";
import HeroCourt from "../components/HeroCourt.astro";
import MottoBanner from "../components/MottoBanner.astro";
import ProjectPanel from "../components/ProjectPanel.astro";
import ScrollServe from "../components/ScrollServe.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import flyBanner from "../assets/banners/fly.webp";

const inProgressTileId = "stm32h723-custom-development-board";
const pcbProjectIds = new Set([
  "formula-electric-can-lte-telemetry",
  "high-side-nmos-surge-protection",
  "stm32h723-custom-development-board",
]);
const roboticsProjectIds = new Set([
  "object-carrying-drone-platform",
  "raspberry-pi-solenoid-inventory-shelf",
]);

const getProjectFilterTags = (id: string, disciplines: string[]) => {
  const disciplineText = disciplines.join(" ").toLowerCase();
  const tags = [];

  if (pcbProjectIds.has(id) || disciplineText.includes("pcb")) {
    tags.push("pcb");
  }

  if (
    roboticsProjectIds.has(id) ||
    disciplineText.includes("robot") ||
    disciplineText.includes("mechatronics") ||
    disciplineText.includes("electromechanical")
  ) {
    tags.push("robotics")
  }

  return tags.join(" ");
};

const projects = (await getCollection("projects"))
  .filter(({ data }) => data.featured)
  .sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title="Tejas Kabra | Electrical Engineering"
  description="Electrical engineering portfolio focused on embedded systems, PCB design, CAN, telemetry, power electronics, and robotics."
>
  <style is:global>
    .project-filter-button[aria-pressed="true"] {
      border-color: var(--color-signal);
      color: var(--color-paper);
      background: var(--color-signal);
      box-shadow: 0 0.9rem 1.8rem rgba(255, 107, 44, 0.16);
    }

    [data-project-card][hidden] {
      display: none;
    }
  </style>

  <MottoBanner image={flyBanner} alt="Haikyuu Fly banner" />

  <section class="court-section court-lines relative overflow-hidden border-b hairline">
    <div class="shell grid min-h-[calc(100vh-5rem)] items-stretch lg:grid-cols-[1.08fr_0.92fr]">
      <div class="relative z-10 flex flex-col justify-center py-20 lg:py-28 lg:pr-16">
        <p class="eyebrow text-signal">Electrical Engineering // Texas A&amp;M</p>
        <h1 class="mt-7 max-w-4xl text-[clamp(4rem,8vw,8.5rem)] font-semibold leading-[0.82] tracking-[-0.075em]">
          Electrical
          <span class="block text-ink/35">engineering.</span>
        </h1>
        <p class="mt-10 max-w-2xl text-lg leading-8 text-ink/65 md:text-xl">
          Embedded systems, custom PCBs, vehicle telemetry, power electronics, and robotics projects
          from schematic through testing.
        </p>
        <div class="mt-10 flex flex-wrap gap-4">
          <a class="bg-signal px-6 py-4 technical-label text-panel transition-transform hover:-translate-y-1 hover:bg-[#ff824f]" href="#projects">
            View projects
          </a>
          <a class="border border-ink/20 px-6 py-4 technical-label transition-colors hover:border-ink" href="/about">
            About Tejas
          </a>
        </div>
      </div>
      <div class="relative min-h-[30rem] border-t hairline bg-panel text-ink lg:min-h-0 lg:border-l lg:border-t-0">
        <HeroCourt />
      </div>
    </div>
  </section>

  <section class="border-b hairline bg-paper-deep">
    <div class="shell grid grid-cols-2 md:grid-cols-4">
      {["STM32 / ARM", "CAN / LTE", "PCB Design", "Power Electronics"].map((skill, index) => (
        <div class:list={["flex min-h-24 items-center gap-4 px-4 md:px-6", index > 0 && "border-l hairline"]}>
          <span class="font-mono text-xs text-signal">0{index + 1}</span>
          <span class="text-sm font-semibold">{skill}</span>
        </div>
      ))}
    </div>
  </section>

  <ScrollServe />

  <section id="projects" class="court-section relative overflow-hidden py-24 md:py-32">
    <div class="shell">
      <div class="grid gap-8 pb-10 md:grid-cols-[minmax(0,1fr)_minmax(18rem,34rem)] md:items-end">
        <div>
          <p class="eyebrow text-signal">Work</p>
          <h2 class="mt-5 text-5xl font-semibold leading-none tracking-[-0.055em] md:text-7xl">Projects</h2>
        </div>
        <p class="max-w-2xl text-base leading-7 text-ink/60 md:justify-self-end md:text-right">
          Hardware, firmware, power electronics, robotics, and telemetry work, with pages updated as
          photos, measurements, and test results come in.
        </p>
      </div>

      <div class="flex flex-wrap gap-3 pb-8" data-project-filters aria-label="Project filters">
        <button class="project-filter-button border border-ink/20 px-4 py-3 technical-label text-ink/65 transition-colors hover:border-signal hover:text-signal" type="button" data-project-filter="all" aria-pressed="true">
          All
        </button>
        <button class="project-filter-button border border-ink/20 px-4 py-3 technical-label text-ink/65 transition-colors hover:border-signal hover:text-signal" type="button" data-project-filter="pcb" aria-pressed="false">
          PCB
        </button>
        <button class="project-filter-button border border-ink/20 px-4 py-3 technical-label text-ink/65 transition-colors hover:border-signal hover:text-signal" type="button" data-project-filter="robotics" aria-pressed="false">
          Robotics / Mechatronics
        </button>
      </div>

      <div class="h-px bg-gradient-to-r from-signal/45 via-ink/12 to-transparent"></div>

      <div class="mt-16 grid gap-x-8 gap-y-20 md:grid-cols-2 lg:gap-x-10" data-project-grid>
        {
          projects.map(({ id, data }, index) => {
            const isInProgressTile = id === inProgressTileId;
            const filterTags = getProjectFilterTags(id, data.disciplines);

            return (
              <article
                class:list={[isInProgressTile ? "group" : "project-card group", index % 2 === 1 && "md:mt-20"]}
                style={`--section-accent:${data.accent}`}
                data-project-card
                data-project-tags={filterTags}
              >
                {isInProgressTile ? (
                  <div class="block" aria-disabled="true">
                    <ProjectPanel
                      title={data.shortTitle}
                      category={data.disciplines[0]}
                      accent={data.accent}
                      accentSecondary={data.accentSecondary}
                      surface={data.themeSurface}
                      index={index}
                      eyebrow="Portfolio section in progress"
                    />
                    <div class="border-b hairline py-6">
                      <div>
                        <p class="technical-label text-signal">{data.disciplines.join(" / ")}</p>
                        <h3 class="mt-3 text-3xl font-semibold leading-tight tracking-[-0.035em] md:text-4xl">{data.shortTitle}</h3>
                      </div>
                    </div>
                    <p class="mt-4 max-w-xl leading-7 text-ink/60">{data.summary}</p>
                    <div class="mt-6 flex flex-wrap gap-3">
                      <span class="border border-current/40 bg-current/10 px-3 py-2 technical-label text-signal shadow-[0_0.8rem_1.6rem_rgba(255,107,44,0.08)]">
                        Portfolio section in progress
                      </span>
                    </div>
                  </div>
                ) : (
                  <a class="block" href={`/projects/${id}/`}>
                    <ProjectPanel
                      title={data.shortTitle}
                      category={data.disciplines[0]}
                      accent={data.accent}
                      accentSecondary={data.accentSecondary}
                      surface={data.themeSurface}
                      index={index}
                    />
                    <div class="border-b hairline py-6">
                      <div>
                        <p class="technical-label text-signal">{data.disciplines.join(" / ")}</p>
                        <h3 class="mt-3 text-3xl font-semibold leading-tight tracking-[-0.035em] md:text-4xl">{data.shortTitle}</h3>
                      </div>
                    </div>
                    <p class="mt-4 max-w-xl leading-7 text-ink/60">{data.summary}</p>
                    <div class="mt-6 grid grid-cols-3 gap-px bg-ink/15">
                      {data.metrics.map((metric) => (
                        <div class="scoreboard p-3">
                          <strong class="score-digit block text-sm">{metric.value}</strong>
                          <span class="technical-label mt-1 block text-ink/40">{metric.label}</span>
                        </div>
                      ))}
                    </div>
                  </a>
                )}
              </article>
            );
          })
        }
      </div>
    </div>
  </section>

  <script is:inline>
    (() => {
      const filterWrap = document.querySelector("[data-project-filters]");
      const cards = Array.from(document.querySelectorAll("[data-project-card]"));
      if (!filterWrap || cards.length === 0) return;

      const buttons = Array.from(filterWrap.querySelectorAll("[data-project-filter]"));

      const setFilter = (filter) => {
        buttons.forEach((button) => {
          button.setAttribute("aria-pressed", String(button.dataset.projectFilter === filter));
        });

        cards.forEach((card) => {
          const tags = (card.dataset.projectTags || "").split(" ").filter(Boolean);
          card.hidden = filter !== "all" && !tags.includes(filter);
        });
      };

      filterWrap.addEventListener("click", (event) => {
        const target = event.target instanceof Element ? event.target : null;
        const button = target?.closest("[data-project-filter]");
        if (!button) return;
        setFilter(button.dataset.projectFilter || "all");
      });
    })();
  </script>
</BaseLayout>
