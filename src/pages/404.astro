---
import { ArrowLeft } from "@lucide/astro";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Page not found | Tejas Kabra"
  description="This page could not be found. Return to Tejas Kabra's engineering portfolio."
>
  <section class="page-intro shell">
    <p class="section-label">404 / Page not found</p>
    <h1>A little off course.</h1>
    <p class="page-lead">
      That page isn’t here. The projects are a good place to start.
    </p>
    <div class="hero-actions">
      <a class="button button-primary" href="/#projects">
        <ArrowLeft size={17} /> Back to my work
      </a>
    </div>
  </section>
</BaseLayout>
