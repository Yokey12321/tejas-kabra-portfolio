---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="About — Tejas Kabra" description="About Tejas Kabra, an electrical engineering student at Texas A&M.">
  <section class="mx-auto max-w-5xl px-6 py-20 lg:px-10 lg:py-28">
    <p class="font-mono text-xs uppercase tracking-[0.18em] text-signal">About</p>
    <h1 class="mt-5 text-5xl font-semibold tracking-[-0.04em] lg:text-7xl">
      Electrical engineering from schematic to tested system.
    </h1>
    <p class="mt-10 max-w-3xl text-xl leading-9 text-ink/70">
      Tejas Kabra is an Electrical Engineering student at Texas A&M focused on embedded systems,
      PCB design, CAN, telemetry, power electronics, and robotics.
    </p>
  </section>
</BaseLayout>
