---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="About — Tejas Kabra" description="About Tejas Kabra, an electrical engineering student at Texas A&M.">
  <section class="shell py-20 md:py-28">
    <p class="eyebrow text-signal">About Tejas</p>
    <div class="mt-8 grid gap-12 lg:grid-cols-[1.15fr_0.85fr]">
      <h1 class="text-6xl font-semibold leading-[0.92] tracking-[-0.065em] md:text-8xl">
        I like the part where the schematic meets reality.
      </h1>
      <div class="self-end">
        <p class="text-xl leading-9 text-ink/65">
          I’m an Electrical Engineering student at Texas A&amp;M focused on embedded systems, PCB design,
          CAN, telemetry, power electronics, and robotics.
        </p>
        <p class="mt-6 leading-8 text-ink/60">
          The work I’m proudest of moves through the full loop: define the requirement, design the circuit,
          write the firmware, instrument the prototype, find the failure, and make the next revision better.
        </p>
      </div>
    </div>
  </section>

  <section class="border-y hairline bg-ink text-paper">
    <div class="shell grid md:grid-cols-3">
      {[
        ["Current", "B.S. Electrical Engineering", "Texas A&M University"],
        ["Seeking", "Fall 2026 Co-op", "Embedded / Hardware / Systems"],
        ["Based", "College Station, Texas", "Open to relocation"],
      ].map(([label, value, detail]) => (
        <div class="border-b border-paper/15 p-7 md:min-h-48 md:border-b-0 md:border-r md:last:border-r-0">
          <span class="technical-label text-signal">{label}</span>
          <strong class="mt-12 block text-2xl">{value}</strong>
          <span class="mt-2 block text-sm text-paper/45">{detail}</span>
        </div>
      ))}
    </div>
  </section>

  <section class="shell grid gap-16 py-24 md:py-32 lg:grid-cols-2">
    <div>
      <p class="eyebrow text-signal">Technical interests</p>
      <h2 class="mt-6 text-5xl font-semibold tracking-[-0.05em]">Systems with consequences.</h2>
    </div>
    <div class="grid grid-cols-2 border-l border-t hairline">
      {["Embedded C/C++", "STM32 / ARM", "CAN systems", "PCB design", "Power protection", "Telemetry", "Test equipment", "Embedded Linux"].map((item, index) => (
        <div class="min-h-28 border-b border-r p-5 hairline">
          <span class="font-mono text-xs text-signal">0{index + 1}</span>
          <strong class="mt-5 block text-sm">{item}</strong>
        </div>
      ))}
    </div>
  </section>
</BaseLayout>
