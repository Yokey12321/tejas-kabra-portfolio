---
import { ArrowUpRight, Download } from "@lucide/astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { profile } from "../data/profile";
---

<BaseLayout
  title="Resume | Tejas Kabra"
  description="Tejas Kabra's electrical engineering resume. Currently an Engineering Intern at SpaceX and seeking summer 2027 internships."
>
  <section class="page-intro shell resume-intro">
    <div>
      <p class="section-label">Resume</p>
      <h1>Tejas Kabra.</h1>
      <p class="page-lead">Electrical engineering / Texas A&amp;M</p>
      <p class="resume-current">
        <span class="status-dot"></span> Currently at SpaceX. Seeking summer
        2027 internships.
      </p>
    </div>
    <div class="hero-actions">
      <a
        class="button button-primary"
        href={profile.resume}
        download="Tejas-Kabra-Resume.pdf"
      >
        <Download size={17} /> Download PDF
      </a>
      <a
        class="button button-quiet"
        href={profile.resume}
        target="_blank"
        rel="noreferrer"
      >
        Open PDF <ArrowUpRight size={17} />
      </a>
    </div>
  </section>
  <section class="shell resume-document">
    <object
      data={`${profile.resume}#view=FitH`}
      type="application/pdf"
      aria-label="Tejas Kabra resume PDF"
    >
      <p>
        <a
          class="text-link"
          href={profile.resume}
          target="_blank"
          rel="noreferrer"
        >
          Open resume PDF <ArrowUpRight size={17} />
        </a>
      </p>
    </object>
  </section>
</BaseLayout>
